#!/bin/bash
# vibePDA configure script — checks build environment and generates config.mk.

set -e
srcdir="$(cd "$(dirname "$0")" && pwd)"
config_mk="$srcdir/config.mk"

echo "checking build environment..."

# Find Go
GO=""
for cand in /usr/local/go/bin/go go; do
  if command -v "$cand" >/dev/null 2>&1; then
    GO="$cand"
    break
  fi
done

if [ -z "$GO" ]; then
  echo "ERROR: go not found. Run: ./scripts/install-go.sh"
  exit 1
fi

# Check Go version (1.24.2+)
ver=$("$GO" version 2>/dev/null | sed -n 's/.*go\([0-9]*\.[0-9]*\.[0-9]*\).*/\1/p')
major=$(echo "$ver" | cut -d. -f1)
minor=$(echo "$ver" | cut -d. -f2)
patch=$(echo "$ver" | cut -d. -f3)

if [ -z "$ver" ]; then
  echo "ERROR: go not found. Run: ./scripts/install-go.sh"
  exit 1
fi
if [ "$major" -lt 1 ] || { [ "$major" -eq 1 ] && [ "$minor" -lt 24 ]; }; then
  echo "ERROR: Go 1.24.2+ required (found: $ver). Run: ./scripts/install-go.sh"
  exit 1
fi
if [ "$minor" -eq 24 ] && [ -n "$patch" ] && [ "$patch" -lt 2 ]; then
  echo "ERROR: Go 1.24.2+ required (found: $ver). Run: ./scripts/install-go.sh"
  exit 1
fi

echo "  go: $($GO version)"
echo "  go path: $GO"

# Optional: check curl (for install-go.sh)
if command -v curl >/dev/null 2>&1; then
  echo "  curl: ok"
else
  echo "  curl: not found (optional, needed for ./scripts/install-go.sh)"
fi

# Write config.mk
echo "creating $config_mk"
cat > "$config_mk" << EOF
# Generated by configure — do not edit
GO = $GO
EOF

echo ""
echo "configure complete. Run: make build"
